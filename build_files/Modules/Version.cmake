INCLUDE(build_files/Modules/GetGitRevisionDescription.cmake)
get_git_head_revision(GIT_REFSPEC GIT_SHA1)
git_get_exact_tag(GIT_EXACT_TAG)
STRING(SUBSTRING ${GIT_SHA1} 0 6 HEAD_HASH)
SET(LHDR_NAME "Luminance HDR")

# Numeric version values
SET(LHDR_VERSION_MAJOR "3")
SET(LHDR_VERSION_MINOR "0")
SET(LHDR_VERSION_PATCH "0")
# Empty for the final release; use rc1, rc2, ... for release candidates.
SET(LHDR_VERSION_PRERELEASE "rc1")

SET(LHDR_VERSION_SEMVER "${LHDR_VERSION_MAJOR}.${LHDR_VERSION_MINOR}.${LHDR_VERSION_PATCH}")
IF(LHDR_VERSION_PRERELEASE)
    SET(LHDR_VERSION_SEMVER "${LHDR_VERSION_SEMVER}-${LHDR_VERSION_PRERELEASE}")
ENDIF()

# Exact release tags get a clean version; development builds keep the hash.
SET(LHDR_VERSION_STR_SUFFIX "_GIT-${HEAD_HASH}")
IF(GIT_EXACT_TAG STREQUAL LHDR_VERSION_SEMVER OR GIT_EXACT_TAG STREQUAL "v${LHDR_VERSION_SEMVER}")
    SET(LHDR_VERSION_STR_SUFFIX "")
ENDIF()

SET(LHDR_VERSION "${LHDR_VERSION_SEMVER}${LHDR_VERSION_STR_SUFFIX}")
SET(LHDR_VENDOR "Luminance HDR Development Team")
SET(LHDR_COPYRIGHT_YEAR "2006-2026")

SET(LHDR_OSX_EXECUTABLE_NAME "${LHDR_NAME} ${LHDR_VERSION}")
SET(LHDR_OSX_EXECUTABLE_TARGET "Luminance_HDR_${LHDR_VERSION}")

SET(LHDR_DOMAIN_FIRST "luminance-hdr")
SET(LHDR_DOMAIN_SECOND "com")
SET(LHDR_DOMAIN "${LHDR_DOMAIN_FIRST}.${LHDR_DOMAIN_SECOND}")
